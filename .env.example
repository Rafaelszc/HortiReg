# Copie para .env e preencha:  cp .env.example .env
# Rodando a API fora do Docker (pytest, uvicorn): copie também para backend/.env.

# --- PostgreSQL ---
POSTGRES_USER=sgv
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sgv

# --- Evolution API (qualquer string longa e aleatória) ---
EVOLUTION_API_KEY=troque-por-uma-chave-grande-e-aleatoria
EVOLUTION_INSTANCE=sgv

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=cole-sua-chave-aqui
GEMINI_MODEL=gemini-2.5-flash

# --- Números autorizados como administrador (DDI+DDD+número, sem +, separados por vírgula) ---
ADMIN_NUMBERS=5583999999999

# --- Painel do administrador ---
# Segredo para assinar a sessão (string longa e aleatória, 32+ caracteres)
JWT_SECRET=troque-por-um-segredo-grande-e-aleatorio
# Conta criada por: docker compose exec api python -m app.seed
ADMIN_LOGIN=admin
ADMIN_PASSWORD=troque-esta-senha
# Opcionais (padrões abaixo): duração da sessão e bloqueio após tentativas erradas
SESSION_MINUTES=30
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- Só fora do Docker (no compose, estes valores são sobrescritos) ---
DATABASE_URL=postgresql+asyncpg://sgv:troque-esta-senha@localhost:5432/sgv
EVOLUTION_URL=http://localhost:8080
